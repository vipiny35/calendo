{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendo",
  "version": "0.2.1",
  "identifier": "com.webtiara.calendo",
  "build": {
    "frontendDist": "../dist/renderer",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/beep.mp3"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "../icons/icon.png",
      "../icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "Developer ID Application: Vipin Yadav (H6892VVKC5)",
      "dmg": {
        "background": "../icons/dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
